{
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/favicon.ico" },
    { "source": "/favicon.png", "destination": "/favicon.png" },
    { "source": "/apple-touch-icon.png", "destination": "/apple-touch-icon.png" },
    { "source": "/web-app-manifest-512x512.png", "destination": "/web-app-manifest-512x512.png" },
    { "source": "/og-image.png", "destination": "/og-image.png" },
    { "source": "/manifest.json", "destination": "/manifest.json" },
    { "source": "/OneSignalSDKWorker.js", "destination": "/OneSignalSDKWorker.js" },
    { "source": "/OneSignalSDKUpdaterWorker.js", "destination": "/OneSignalSDKUpdaterWorker.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}